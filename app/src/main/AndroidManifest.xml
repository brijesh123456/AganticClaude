<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AganticClaude">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AganticClaude">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CrashListActivity" />

        <activity android:name=".CrashIssueDetailsActivity" />

        <activity android:name=".AlertTypesListActivity" />

        <activity android:name=".AnrCrashDetailActivity" />

        <activity android:name=".FatalCrashDetailActivity" />

        <activity android:name=".NonFatalCrashDetailActivity" />

        <activity android:name=".RegressionDetailActivity" />

        <activity android:name=".StabilityDigestDetailActivity" />

        <activity android:name=".VelocityAlertDetailActivity" />

    </application>

</manifest>